# Copy to .env. Never commit real keys.
# Backends: claude | openai | openai-compatible | offline
TOFU_PROVIDER=offline

# Explicit model selection. For the whitepaper's Claude model:
# TOFU_PROVIDER=claude
# TOFU_MODEL=claude-haiku-4-5-20251001
CLAUDE_API_KEY=

# OpenAI-compatible Chat Completions:
# TOFU_PROVIDER=openai
# TOFU_MODEL=<your provider's model ID>
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Some compatible servers require max_tokens instead.
TOFU_OPENAI_TOKEN_PARAMETER=max_completion_tokens

# Optional isolated project/user directory (all memory files).
# TOFU_DATA_DIR=/absolute/path/to/private/tofu-data
# Individual TOFU_ENDPOINTS_PATH, TOFU_PROFILE_PATH, TOFU_SESSIONS_DIR,
# TOFU_ZONE_HISTORY_PATH and TOFU_WORDS_DIR still take precedence.
